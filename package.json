{
  "name": "mkrecord",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:dev": "ng serve --configuration development",
    "start:prod": "ng serve  --configuration production",
    "build:dev": "ng build --configuration development",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "serve:dev:ssr:mkrecord": "cross-env NODE_ENV=development node dist/mkrecord/server/server.mjs",
    "serve:prod:ssr:mkrecord": "cross-env NODE_ENV=production node dist/mkrecord/server/server.mjs",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss,json}\"",
    "test": "ng test --no-watch",
    "test:watch": "ng test",
    "test:coverage": "ng test --no-watch --coverage"
  },
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "dependencies": {
    "@angular/animations": "^22.0.7",
    "@angular/cdk": "21.2.3",
    "@angular/common": "^22.0.7",
    "@angular/compiler": "^22.0.7",
    "@angular/core": "^22.0.7",
    "@angular/forms": "^22.0.7",
    "@angular/material": "21.2.3",
    "@angular/platform-browser": "^22.0.7",
    "@angular/platform-browser-dynamic": "^22.0.7",
    "@angular/platform-server": "^22.0.7",
    "@angular/router": "^22.0.7",
    "@angular/service-worker": "^22.0.7",
    "@angular/ssr": "^22.0.7",
    "@angular/youtube-player": "21.2.3",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "envalid": "^8.1.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "nodemailer": "^8.0.7",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^21.3.1",
    "@angular-eslint/eslint-plugin-template": "^21.3.1",
    "@angular-eslint/template-parser": "^21.3.1",
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.7",
    "@netlify/angular-runtime": "^4.0.0",
    "@netlify/functions": "^5.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^8.0.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^6.0.1",
    "jsdom": "^29.0.1",
    "ngx-device-detector": "^11.0.0",
    "prettier": "3.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.0"
  }
}
